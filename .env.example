# Local development (Docker Compose Postgres). For production use a Neon DATABASE_URL.
DATABASE_URL="postgresql://seeker:seeker@localhost:5432/seeker?schema=public"

# Vercel Blob — pull the real token with: pnpm dlx vercel@latest env pull .env.local --yes
# BLOB_READ_WRITE_TOKEN=

# Optional CDN origin for heavy pack media (no trailing slash). Unset = git /content paths.
# CONTENT_ASSET_BASE=https://<store-id>.public.blob.vercel-storage.com
